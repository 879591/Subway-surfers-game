<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0F172A" />
      <stop offset="50%" stop-color="#1E1B4B" />
      <stop offset="100%" stop-color="#7C2D12" />
    </linearGradient>
    <linearGradient id="starGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FDE047" />
      <stop offset="50%" stop-color="#F59E0B" />
      <stop offset="100%" stop-color="#EA580C" />
    </linearGradient>
    <linearGradient id="shirtGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FACC15" />
      <stop offset="100%" stop-color="#EAB308" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="8" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Rounded Square App Icon Background -->
  <rect width="512" height="512" rx="112" fill="url(#bgGrad)" />
  <rect x="12" y="12" width="488" height="488" rx="100" fill="none" stroke="url(#starGrad)" stroke-width="6" opacity="0.6" />

  <!-- Speed Trail Lines -->
  <path d="M60 320 L190 250 M45 365 L175 295 M85 260 L185 205" stroke="#F59E0B" stroke-width="10" stroke-linecap="round" opacity="0.45" />

  <!-- Dynamic 5-Pointed Star Behind Runner -->
  <polygon points="256,56 305,165 424,178 335,258 360,375 256,314 152,375 177,258 88,178 207,165" fill="url(#starGrad)" filter="url(#glow)" opacity="0.9" />

  <!-- Stylized Suraj Runner Silhouette & Character -->
  <!-- Curly Wavy Black Hair -->
  <path d="M225 140 C215 120, 240 105, 258 112 C275 102, 298 118, 292 138 C304 148, 296 168, 285 170 L225 168 C212 162, 215 145, 225 140 Z" fill="#18181B" />
  <!-- Head -->
  <circle cx="256" cy="166" r="28" fill="#D97736" />
  <!-- Red Tilak on Forehead -->
  <path d="M256 144 L260 156 L256 160 L252 156 Z" fill="#EF4444" />
  <!-- Smile -->
  <path d="M248 176 Q256 183 265 176" stroke="#FFFFFF" stroke-width="3.5" fill="none" stroke-linecap="round" />

  <!-- Yellow Shirt Torso (Running Forward Pose) -->
  <path d="M230 196 L284 196 L298 272 L220 272 Z" rx="12" fill="url(#shirtGrad)" stroke="#FEF08A" stroke-width="2" />
  <!-- Running Arms -->
  <path d="M232 204 L185 240 L205 265" stroke="#FACC15" stroke-width="18" stroke-linecap="round" stroke-linejoin="round" fill="none" />
  <path d="M282 204 L328 232 L308 190" stroke="#FACC15" stroke-width="18" stroke-linecap="round" stroke-linejoin="round" fill="none" />

  <!-- Bold 5TAR Badge at Bottom -->
  <rect x="86" y="378" width="340" height="84" rx="24" fill="#090D16" stroke="#F59E0B" stroke-width="5" />
  <text x="256" y="438" font-family="'Chakra Petch', Impact, sans-serif" font-size="68" font-weight="900" font-style="italic" text-anchor="middle" fill="url(#starGrad)" letter-spacing="4">5TAR</text>
</svg>
